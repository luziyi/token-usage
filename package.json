{
  "name": "token-usage",
  "productName": "Token Usage",
  "version": "1.1.0",
  "description": "本地优先的 OpenCode Token 消耗监控与费用计算桌面工具",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win portable",
    "check": "node -e \"require('./src/calculator');require('./src/pricing');require('./src/store');console.log('✓ check passed')\""
  },
  "build": {
    "appId": "com.token-usage.app",
    "productName": "Token Usage",
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    }
  },
  "keywords": [
    "token-usage",
    "token-count",
    "opencode",
    "electron",
    "desktop-widget",
    "local-first"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@lobehub/icons": "^5.10.0",
    "@lobehub/icons-static-svg": "^1.91.0",
    "chokidar": "^3.6.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "electron": "42.2.0",
    "electron-builder": "^26.15.0"
  }
}
