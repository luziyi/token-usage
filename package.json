{
  "name": "token-usage",
  "productName": "Token Usage",
  "version": "1.1.0",
  "description": "本地优先的 OpenCode Token 消耗监控与费用计算桌面工具",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --publish=never",
    "check": "node -e \"require('./src/calculator');require('./src/pricing');require('./src/store');console.log('✓ check passed')\""
  },
  "build": {
    "appId": "com.token-usage.app",
    "productName": "TokenUsage",
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": ["portable", "nsis"],
      "icon": "assets/icon.png",
      "artifactName": "${productName}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Token Usage",
      "uninstallDisplayName": "Token Usage ${version}",
      "artifactName": "${productName}-setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-mac.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-linux.${ext}"
    }
  },
  "keywords": [
    "token-usage",
    "token-count",
    "opencode",
    "electron",
    "desktop-widget",
    "local-first"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@lobehub/icons": "^5.10.0",
    "@lobehub/icons-static-svg": "^1.91.0",
    "chokidar": "^3.6.0",
    "sql.js": "^1.11.0"
  },
  "devDependencies": {
    "electron": "42.2.0",
    "electron-builder": "^26.15.0"
  }
}
